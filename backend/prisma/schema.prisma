generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int      // whole rupees
  packSize    String   // e.g. "500 ml"
  imageUrl    String
  imageId     String?  // S3 object key, used when deleting
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Settings {
  id             Int    @id @default(1) // always a single row
  whatsappNumber String @default("")
  phone          String @default("")
  address        String @default("")
  facebookUrl    String @default("")
  instagramUrl   String @default("")
  youtubeUrl     String @default("")
  fssaiNumber    String @default("") // blank = hidden on site
  hours          String @default("") // blank = hidden on site
  maxCartQty     Int    @default(10) // per product line
}

model Admin {
  id           Int    @id @default(1) // single row
  email        String
  passwordHash String // scrypt "salt:hash"
}

// One row per cart checkout (WhatsApp order tap)
model Click {
  id        Int         @id @default(autoincrement())
  total     Int         @default(0)
  address   String? // optional, only if the visitor allowed location
  latitude  Float?
  longitude Float?
  createdAt DateTime    @default(now())
  items     ClickItem[]

  @@index([createdAt])
}

model ClickItem {
  id          Int    @id @default(autoincrement())
  clickId     Int
  click       Click  @relation(fields: [clickId], references: [id], onDelete: Cascade)
  productId   Int? // null once the product is deleted
  productName String // "Milk (500 ml)", kept for history and filtering
  qty         Int
  price       Int

  @@index([productName])
}
